{
  "family": "hotel-booking",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/hotel-booking-ecs-exec-role",
  "containerDefinitions": [
    {
      "name": "hotel-booking",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/hotel-booking:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "SERVER_PORT",            "value": "8080" },
        { "name": "DB_URL",                 "value": "jdbc:mysql://<RDS_ENDPOINT>:3306/hotelbooking?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true" }
      ],
      "secrets": [
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:hotel-booking/db-credentials:username::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:hotel-booking/db-credentials:password::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:hotel-booking/jwt-secret"
        },
        {
          "name": "SPRING_MAIL_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:hotel-booking/mail-credentials:username::"
        },
        {
          "name": "SPRING_MAIL_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:hotel-booking/mail-credentials:password::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/hotel-booking",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command":     ["CMD-SHELL", "curl -sf http://localhost:8080/actuator/health || exit 1"],
        "interval":    30,
        "timeout":     5,
        "retries":     3,
        "startPeriod": 60
      }
    }
  ]
}
